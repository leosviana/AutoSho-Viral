# Credenciais do painel Open API (Shopee Afiliados)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Chave de API do Google Gemini
GEMINI_API_KEY=

# Necessário para o catálogo Shopee e o Realtime Database; mantenha a chave privada fora do Git
FIREBASE_SERVICE_ACCOUNT=./server/serviceAccountKey-firebase.json
FIREBASE_DATABASE_URL=https://autosho-viral-default-rtdb.firebaseio.com

PORT=3000
